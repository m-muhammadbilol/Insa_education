# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Server-only key. Keep this out of browser code, GitHub, and chat.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Telegram lead notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# One-time initial Super Admin bootstrap
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=choose-a-strong-temporary-password
