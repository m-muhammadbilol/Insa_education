# ========================================================
# INSA EDUCATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env.local and fill in with your real credentials.
# NEVER commit .env.local to version control!

# --------------------------------------------------------
# Firebase Client SDK (Public Web Configuration)
# --------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --------------------------------------------------------
# Firebase Admin SDK (Server-Side Privileged Credentials)
# Obtain from Firebase Console -> Project Settings -> Service Accounts
# --------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# On Vercel / single-line environments, replace real newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------
# Telegram Lead Notification Service
# --------------------------------------------------------
# Create a bot via @BotFather on Telegram and paste token below
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Group or Admin Chat ID (e.g. -1001234567890 for supergroup or user ID)
TELEGRAM_CHAT_ID=-1001234567890

# --------------------------------------------------------
# Super Admin One-Time Bootstrap Credentials
# --------------------------------------------------------
BOOTSTRAP_SUPERADMIN_USERNAME=insa_superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=SuperAdminSecretPass2026!
